# GEMINI_API_KEY: Required for Gemini AI API calls (Trip planning, chatbot, itinerary modifications).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional API key for Google Maps Javascript API, Routes & Places.
# If not provided, the platform automatically uses the high-fidelity interactive map fallback with full route & attraction rendering.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

